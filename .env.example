# Copia este archivo a .env y cambia los secretos.
# En PowerShell puedes generar un valor aleatorio con:
#   [Convert]::ToBase64String((New-Object byte[] 32 | %{ [byte](Get-Random -Max 256) }))

AIRFLOW_IMAGE_NAME=airflow-calidad-aire:3.4.0
AIRFLOW_UID=50000

# Puerto del panel web en Windows
AIRFLOW_UI_PORT=8081

FERNET_KEY=cambia-esta-clave

AIRFLOW__API_AUTH__JWT_SECRET=cambia-este-secreto
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=cambia-esta-contrasena
